{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Cache-Control": "public, must-revalidate, max-age=30",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".zip": "application/zip"
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "routes": [
    { "route": "/", "rewrite": "/index.html" },
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/library", "rewrite": "/index.html" },
    { "route": "/review", "rewrite": "/index.html" },
    { "route": "/privacy", "rewrite": "/index.html" },
    { "route": "/terms", "rewrite": "/index.html" },
    { "route": "/404.html", "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex" } },
    { "route": "/build-info.json", "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/downloads/*", "headers": { "Cache-Control": "public, max-age=3600" } }
  ]
}
