{
  "name": "reading-margin-recall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:extension": "wxt",
    "build:site:vite": "vite build --config vite.config.ts",
    "build:site": "node scripts/build.mjs",
    "build:extension": "wxt build && wxt zip",
    "build": "npm run build:site",
    "verify:deployment": "node scripts/verify-deployment-tree.mjs",
    "deploy:site": "npm run build:site && npm run verify:deployment && /opt/fleet/lib/deploy-static.sh reading-margin-recall dist/site && npm run verify:live",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "test": "npm run build && playwright test",
    "verify:live": "node scripts/verify-live.mjs",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "wxt": "0.21.4"
  }
}
